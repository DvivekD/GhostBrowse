# GhostBrowser Environment Configuration Template
# Copy this file to .env before starting the services

# 1. Ultra-Fast Silicon & Reasoning (Free Tier APIs)
# SambaNova Cloud (SN40L RDU 450 t/s Llama 3.3 / 200 t/s DeepSeek-R1 full) -> https://cloud.sambanova.ai
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Google AI Studio (Gemini 3.8 Flash Vision & Multimodal) -> https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Groq Cloud (Ultra-Fast LPU Inference & Whisper STT) -> https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 2. Cloud Stealth Browser Fleet
# Steel.dev ($30 free trial credit, ~300 cloud browser hours) -> https://app.steel.dev
STEEL_API_KEY=your_steel_dev_api_key_here

# 3. Real-Time Conversational Voice
# Deepgram Nova-3 STT & Aura-2 TTS ($200 free credit) -> https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Cartesia Sonic-3.6 Ultra-Low Latency TTS (20k free credits/mo) -> https://play.cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key_here

# 4. Engine & Service Ports
GHOST_ENGINE_PORT=8000
GHOST_ENGINE_HOST=127.0.0.1
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# 5. Browser Automation Limits
HEADLESS=true
MAX_PARALLEL_WORKERS=3
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
DEMO_MOCK_FALLBACK=true
